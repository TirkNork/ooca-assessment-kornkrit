# Required
OPENAI_API_KEY=

# Optional (defaults shown)
# OPENAI_MODEL=gpt-6-luna
# OPENAI_TEMPERATURE=              # unset = model default
# OPENAI_TIMEOUT_S=60
# OPENAI_MAX_RETRIES=3
# OPENAI_REQUESTS_PER_SECOND=2    # client-side throttle; leave unset for no limit
# DATA_DIR=/app/data
# REPOSITORY_BACKEND=file          # or postgres (run scripts/seed_db.py first)
# DATABASE_URL=                    # set by compose for the app/api containers
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# KB_MIN_SIMILARITY=0.3            # min cosine similarity for a semantic KB match
# MAX_TOOL_ITERATIONS=6
# LOG_LEVEL=INFO

# Optional LangSmith tracing: full step-by-step traces (read by LangChain/LangGraph directly)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ticket-triage
