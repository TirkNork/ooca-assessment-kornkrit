# Required
OPENAI_API_KEY=

# Optional (defaults shown)
# OPENAI_MODEL=gpt-6-luna
# OPENAI_TEMPERATURE=              # unset = model default
# OPENAI_TIMEOUT_S=60
# OPENAI_MAX_RETRIES=3
# OPENAI_REQUESTS_PER_SECOND=2    # client-side throttle; leave unset for no limit
# DATA_DIR=/app/data
# MAX_TOOL_ITERATIONS=6
# LOG_LEVEL=INFO
# LOG_FORMAT=console              # or json
